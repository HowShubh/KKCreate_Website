            "level": "error"
          }
        ],
        "name": "location",
        "type": "geopoint",
        "title": "Location on the map"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "title",
        "type": "string",
        "title": "Video title"
      },
      {
        "description": "e.g. \"2.1M views\" — shown under the title.",
        "name": "views",
        "type": "string",
        "title": "Views label"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "url",
        "type": "url",
        "title": "YouTube URL"
      },
      {
        "options": {
