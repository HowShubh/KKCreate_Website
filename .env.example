# Sanity — create a free project at https://www.sanity.io/manage, then copy the
# project id here. Set the SAME value in the NEXT_PUBLIC_* and SANITY_STUDIO_*
# pairs (Next reads NEXT_PUBLIC_*, the Sanity CLI/Studio reads SANITY_STUDIO_*).
# Leaving these blank is fine — the site falls back to the built-in static catalog.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Server-only read token (Viewer role) — required because the project restricts
# anonymous reads. Create it at Manage → API → Tokens. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only WRITE token (Editor role) — powers the Medium-style /write editor.
# Create at Manage → API → Tokens with the "Editor" role. Never NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Shared password for the /write editor (any string your writers know).
# Leaving it blank disables the editor entirely.
EDITOR_PASSWORD=

# Set to "true" to publish the photo-essay section. While unset, /photo-essays
# shows a coming-soon banner, essay URLs 404, and the section is left out of
# sitemap.xml, feed.xml and llms.txt. The writers' area at /write is unaffected,
# so drafting can continue before launch. NEXT_PUBLIC_ values are baked in at
# build time — changing this needs a redeploy.
NEXT_PUBLIC_PHOTO_ESSAYS_LIVE=

# Canonical site origin for sitemap.xml, feed.xml, llms.txt, JSON-LD and OG
# tags, e.g. https://kkcreate.com — REQUIRED in production.
NEXT_PUBLIC_SITE_URL=

# Shared secret for the Sanity → /api/revalidate webhook (any long random string).
# Add the same value to the webhook URL: https://<host>/api/revalidate?secret=<value>
SANITY_REVALIDATE_SECRET=

# Server-only YouTube Data API v3 key — auto-fills empty "views" labels on the
# filmed-places map with live view counts. Optional: leave blank and the views
# line simply stays empty. Create at console.cloud.google.com (enable
# "YouTube Data API v3" → Credentials → API key).
YOUTUBE_API_KEY=
