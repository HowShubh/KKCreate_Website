# Sanity — create a free project at https://www.sanity.io/manage, then copy the
# project id here. Set the SAME value in the NEXT_PUBLIC_* and SANITY_STUDIO_*
# pairs (Next reads NEXT_PUBLIC_*, the Sanity CLI/Studio reads SANITY_STUDIO_*).
# Leaving these blank is fine — the site falls back to the built-in static catalog.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Server-only read token (Viewer role) — required because the project restricts
# anonymous reads. Create it at Manage → API → Tokens. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity → /api/revalidate webhook (any long random string).
# Add the same value to the webhook URL: https://<host>/api/revalidate?secret=<value>
SANITY_REVALIDATE_SECRET=
